# Copy to .env and fill in. .env is ignored by git: never commit keys.

# OAuth client of the site: Google Auth Platform -> Clients -> Web application.
# Authorised JavaScript origins: http://localhost:4321, http://localhost:8080 and the public URL.
GOOGLE_CLIENT_ID=
# Signs the session cookie. Generate one with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Financial Modeling Prep (same key as fundamentals-lab)
FMP_API_KEY=
# The SEC asks for a contact in the User-Agent: "market-hub you@example.com"
SEC_USER_AGENT=

# Addresses of the tools the portal opens
EARNINGS_RADAR_URL=https://earningsradar.app
FUNDAMENTALS_LAB_URL=

# Local development over plain http (never in production)
MARKETHUB_INSECURE_COOKIES=1
