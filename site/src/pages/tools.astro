---
import Page from "../components/Page.astro";
---

<Page title="Tools" description="The analysis tools of Market Hub." app>
	<h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900">Analysis tools</h1>
	<p class="mt-2 max-w-2xl text-stone-600">Each tool works on any US-listed company. From the dashboard, every stock links straight to them.</p>
	<div id="tools" class="mt-8 grid gap-4 md:grid-cols-2"></div>
</Page>

<script>
	import { config } from "../lib/api";
	import { add, h } from "../lib/dom";

	const TOOLS = [
		{
			key: "fundamentals_lab" as const,
			name: "Fundamentals Lab",
			text: "Ten years of statements and twelve quarters, margins and returns on capital, valuation against the company's own history, forward multiples from the analysts' consensus, technical analysis and side-by-side comparison of up to five companies. With an AI reading of the numbers.",
		},
		{
			key: "earnings_radar" as const,
			name: "Earnings Radar",
			text: "Reads a company's latest results release the moment you ask: is guidance raised or cut, is demand weakening, are margins under pressure, which themes it talks about. Plus market trends across 99 large companies since 2021.",
		},
	];
	const root = document.getElementById("tools")!;
	config()
		.then((cfg) => {
			root.replaceChildren(...TOOLS.map((t) => {
				const url = cfg.tools[t.key];
				const el = h(url ? "a" : "div", `block rounded-2xl border border-stone-200 bg-white p-6 ${url ? "transition hover:border-stone-400" : ""}`);
				if (url) (el as HTMLAnchorElement).href = url;
				return add(el,
					add(h("div", "flex items-center justify-between gap-3"), h("h2", "font-serif text-xl font-semibold text-stone-900", t.name), h("span", "text-sm text-stone-500", url ? "Open ↗" : "Coming soon")),
					h("p", "mt-3 text-sm leading-relaxed text-stone-600", t.text));
			}));
		})
		.catch(() => root.replaceChildren(h("p", "text-sm text-stone-500", "The tools list is not available right now.")));
</script>
