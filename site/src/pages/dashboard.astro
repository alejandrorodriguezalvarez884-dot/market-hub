---
import Page from "../components/Page.astro";
---

<Page title="Dashboard" description="Your portfolio and your favourite stocks." app wide>
	<div id="dash"><p class="animate-pulse text-sm text-stone-500">Loading your dashboard…</p></div>
</Page>

<script>
	import { api, config, requireUser, toolLinks, type Config } from "../lib/api";
	import { lineChart, SERIES } from "../lib/charts";
	import { add, card, h, stat, toneOf } from "../lib/dom";
	import { money, pct, price, signedPct } from "../lib/format";
	import { link, tidyName } from "../lib/site";
	import { sparkline } from "../lib/spark";
	import type { Dashboard, Row, Watch } from "../lib/types";

	const root = document.getElementById("dash")!;
	const tone = (v: number | null | undefined) => (v == null ? "text-stone-900" : v > 0 ? "text-emerald-700" : v < 0 ? "text-rose-700" : "text-stone-900");
	const cell = (text: string, cls = "text-stone-900") => h("td", cls, text);

	function greeting(name: string) {
		const hour = new Date().getHours();
		const part = hour < 12 ? "Good morning" : hour < 19 ? "Good afternoon" : "Good evening";
		return `${part}, ${name.split(" ")[0]}`;
	}

	function tools(cfg: Config, ticker: string, fund = false): HTMLElement {
		const links = toolLinks(cfg.tools, ticker);
		// Funds publish no results releases.
		if (fund) links.earnings = null;
		const el = h("div", "flex justify-end gap-1");
		const a = (href: string | null, label: string, title: string) => {
			if (!href) return null;
			const x = h("a", "rounded-full border border-stone-200 px-2 py-0.5 text-[11px] font-medium text-stone-600 hover:border-stone-400 hover:text-stone-900", label) as HTMLAnchorElement;
			x.href = href;
			x.title = title;
			x.target = "_blank";
			x.rel = "noopener";
			return x;
		};
		return add(el, a(links.fundamentals, "Numbers", `${ticker} in Fundamentals Lab`), a(links.earnings, "Earnings", `${ticker}'s latest results in the Earnings Radar`));
	}

	function nameCell(t: string, name: string): HTMLElement {
		return add(h("td"), h("div", "font-semibold text-stone-900", t), h("div", "max-w-[11rem] truncate text-xs text-stone-500", tidyName(name)));
	}

	function holdings(d: Dashboard, cfg: Config): HTMLElement {
		const c = card("Positions", d.totals.cost_covers < d.totals.positions ? "Gain and loss only where you entered an average cost." : undefined);
		const t = h("table", "data-table");
		const head = ["Stock", "Shares", "Avg cost", "Price", "Today", "Value", "Weight", "Gain / loss", "Gain %", "1 year", "3 months", ""];
		add(t, add(h("thead"), add(h("tr"), ...head.map((x) => h("th", "", x)))),
			add(h("tbody"), ...d.positions.map((r: Row) => add(h("tr"),
				nameCell(r.ticker, r.name),
				cell(r.shares.toLocaleString("en-US", { maximumFractionDigits: 4 })),
				cell(price(r.avg_cost), "text-stone-500"),
				cell(price(r.price)),
				cell(signedPct(r.day_change_pct), tone(r.day_change_pct)),
				cell(money(r.value)),
				cell(pct(r.weight)),
				cell(r.pnl == null ? "—" : `${r.pnl >= 0 ? "+" : ""}${money(r.pnl)}`, tone(r.pnl)),
				cell(signedPct(r.pnl_pct), tone(r.pnl_pct)),
				cell(signedPct(r.return_1y), tone(r.return_1y)),
				add(h("td"), sparkline(r.spark)),
				add(h("td"), tools(cfg, r.ticker, r.sector === "ETF / fund")),
			))));
		c.body.append(add(h("div", "overflow-x-auto"), t));
		return c.el;
	}

	function watchTable(d: Dashboard, cfg: Config): HTMLElement {
		const c = card("Favourites", "Stocks you follow");
		const t = h("table", "data-table");
		const head = ["Stock", "Price", "Today", "1 month", "YTD", "1 year", "From 52-week high", "3 months", ""];
		add(t, add(h("thead"), add(h("tr"), ...head.map((x) => h("th", "", x)))),
			add(h("tbody"), ...d.watchlist.map((w: Watch) => add(h("tr"),
				nameCell(w.ticker, w.name),
				cell(price(w.price)),
				cell(signedPct(w.day_change_pct), tone(w.day_change_pct)),
				cell(signedPct(w.return_1m), tone(w.return_1m)),
				cell(signedPct(w.return_ytd), tone(w.return_ytd)),
				cell(signedPct(w.return_1y), tone(w.return_1y)),
				cell(signedPct(w.from_high_52w), "text-stone-600"),
				add(h("td"), sparkline(w.spark)),
				add(h("td"), tools(cfg, w.ticker)),
			))));
		c.body.append(add(h("div", "overflow-x-auto"), t));
		return c.el;
	}

	function allocation(d: Dashboard): HTMLElement {
		const c = card("Allocation", "Share of the portfolio's value");
		const bars = (items: { label: string; weight: number }[]) => add(h("div", "space-y-2"), ...items.map((it) => {
			const bar = h("div", "h-2 rounded-full");
			bar.style.width = `${Math.max(1, it.weight * 100)}%`;
			bar.style.background = SERIES[0];
			return add(h("div"), add(h("div", "mb-1 flex justify-between gap-3 text-sm"), h("span", "truncate text-stone-700", it.label), h("span", "font-medium tabular-nums text-stone-900", pct(it.weight))),
				add(h("div", "h-2 rounded-full bg-stone-100"), bar));
		}));
		add(c.body, add(h("div", "grid gap-6 sm:grid-cols-2"),
			add(h("div"), h("h4", "mb-3 text-xs font-medium uppercase tracking-wide text-stone-500", "By position"),
				bars(d.positions.filter((p) => p.weight != null).slice(0, 10).map((p) => ({ label: p.ticker, weight: p.weight! })))),
			add(h("div"), h("h4", "mb-3 text-xs font-medium uppercase tracking-wide text-stone-500", "By sector"),
				bars(d.sectors.map((s) => ({ label: s.sector, weight: s.weight }))))));
		return c.el;
	}

	function history(d: Dashboard): HTMLElement {
		const hst = d.history;
		const c = card("Your holdings over the last year", `Today's positions held through the year, against the S&P 500 (${hst.benchmark ?? "SPY"}), both from 100. Trades are not recorded, so this is not your actual past return.`);
		if (!hst.dates.length) return (c.body.append(h("p", "text-sm text-stone-500", "No common price history yet.")), c.el);
		const labels = hst.dates.map((x) => new Date(`${x}T00:00:00Z`).toLocaleDateString("en-US", { month: "short", day: "numeric", year: "2-digit", timeZone: "UTC" }));
		c.body.append(lineChart(labels, [
			{ name: "Your holdings", values: hst.portfolio_rebased },
			{ name: "S&P 500", values: hst.benchmark_rebased, color: "#a8a29e" },
		], "num"));
		return c.el;
	}

	function toolCards(cfg: Config): HTMLElement {
		const items = [
			["Fundamentals Lab", "Every number of a company: statements, valuation history, forward multiples, technicals and comparison.", cfg.tools.fundamentals_lab],
			["Earnings Radar", "What a company's latest results release says: guidance, demand, margins and themes, read by a model.", cfg.tools.earnings_radar],
		] as const;
		return add(h("div", "grid gap-4 sm:grid-cols-2"), ...items.map(([name, text, url]) => {
			const el = h(url ? "a" : "div", `block rounded-2xl border border-stone-200 bg-white p-5 ${url ? "transition hover:border-stone-400" : "opacity-70"}`);
			if (url) (el as HTMLAnchorElement).href = url;
			return add(el, add(h("div", "flex items-center justify-between"), h("h3", "font-serif text-lg font-semibold text-stone-900", name),
				h("span", "text-xs text-stone-500", url ? "Open ↗" : "Coming soon")), h("p", "mt-2 text-sm text-stone-600", text));
		}));
	}

	function draw(name: string, d: Dashboard, cfg: Config) {
		const t = d.totals;
		const today = new Date().toLocaleDateString("en-US", { weekday: "long", month: "long", day: "numeric" });
		const edit = h("a", "rounded-full border border-stone-300 px-3 py-1.5 text-sm font-medium text-stone-700 hover:border-stone-500", "Edit portfolio") as HTMLAnchorElement;
		edit.href = link("/portfolio/");
		const header = add(h("div", "mb-6 flex flex-wrap items-end justify-between gap-3"),
			add(h("div"), h("h1", "font-serif text-3xl font-semibold tracking-tight text-stone-900", greeting(name)), h("p", "mt-1 text-sm text-stone-500", today)), edit);

		const tiles = add(h("div", "grid grid-cols-2 gap-x-6 gap-y-5 rounded-2xl border border-stone-200 bg-white p-5 sm:grid-cols-4 sm:p-6"),
			stat("Portfolio value", money(t.value), t.positions ? `${t.positions} position${t.positions > 1 ? "s" : ""}` : "No positions"),
			stat("Today", t.day_change == null ? "—" : `${t.day_change >= 0 ? "+" : ""}${money(t.day_change)}`, signedPct(t.day_change_pct, 2), toneOf(t.day_change)),
			stat("Gain / loss", t.pnl == null ? "—" : `${t.pnl >= 0 ? "+" : ""}${money(t.pnl)}`, t.pnl_pct != null ? `${signedPct(t.pnl_pct)} on your cost` : "Add average costs to see it", toneOf(t.pnl)),
			stat("S&P 500 today", signedPct(d.benchmark.day_change_pct, 2), d.benchmark.return_ytd != null ? `${signedPct(d.benchmark.return_ytd)} this year` : undefined, toneOf(d.benchmark.day_change_pct)),
		);

		const moves = [...d.movers.up.map((x) => [x, "up"]), ...d.movers.down.map((x) => [x, "down"])];
		const movers = moves.length
			? add(h("div", "flex flex-wrap items-center gap-2 text-sm"), h("span", "text-stone-500", "Moving most today:"),
				...moves.map(([x, dir]) => {
					const all = [...d.positions, ...d.watchlist].find((r) => r.ticker === x)!;
					return h("span", `rounded-full px-2.5 py-0.5 text-xs font-semibold ${dir === "up" ? "bg-emerald-50 text-emerald-800" : "bg-rose-50 text-rose-800"}`, `${x} ${signedPct(all.day_change_pct)}`);
				}))
			: null;

		const parts: (HTMLElement | null)[] = [header, d.positions.length ? tiles : null, movers];
		if (d.positions.length) parts.push(history(d), holdings(d, cfg), allocation(d));
		if (d.watchlist.length) parts.push(watchTable(d, cfg));
		parts.push(add(h("section"), h("h2", "mb-3 font-serif text-xl font-semibold text-stone-900", "Analysis tools"), toolCards(cfg)));
		for (const n of d.notes) parts.push(h("p", "text-xs text-amber-700", n));
		root.replaceChildren(add(h("div", "grid min-w-0 gap-5"), ...parts));
	}

	async function start() {
		const who = await requireUser();
		if (!who.has_data) return location.replace(link("/portfolio/?welcome=1"));
		try {
			const [d, cfg] = await Promise.all([api<Dashboard>("/api/dashboard"), config()]);
			draw(who.user.name, d, cfg);
		} catch (e) {
			root.replaceChildren(h("p", "rounded-xl border border-rose-200 bg-rose-50 p-4 text-sm text-rose-800", e instanceof Error ? e.message : "The dashboard failed to load."));
		}
	}
	start().catch(() => {});
</script>
