---
import Page from "../components/Page.astro";
---

<Page title="Account" description="Your account and your data." app>
	<h1 class="font-serif text-3xl font-semibold tracking-tight text-stone-900">Account and data</h1>
	<div id="account-page" class="mt-8 max-w-2xl space-y-6"></div>
</Page>

<script>
	import { api, requireUser, type Portfolio } from "../lib/api";
	import { add, card, h } from "../lib/dom";
	import { link } from "../lib/site";

	const root = document.getElementById("account-page")!;

	async function start() {
		const who = await requireUser();
		const p = await api<Portfolio>("/api/portfolio");
		const info = card("What we keep", "Everything stored about you, as saved now");
		add(info.body, add(h("dl", "grid grid-cols-[8rem_1fr] gap-y-2 text-sm"),
			h("dt", "text-stone-500", "Name"), h("dd", "text-stone-900", who.user.name),
			h("dt", "text-stone-500", "Email"), h("dd", "text-stone-900", who.user.email),
			h("dt", "text-stone-500", "Positions"), h("dd", "text-stone-900", p.positions.map((x) => `${x.ticker} (${x.shares})`).join(", ") || "None"),
			h("dt", "text-stone-500", "Favourites"), h("dd", "text-stone-900", p.watchlist.join(", ") || "None"),
		));
		const download = h("button", "mt-4 rounded-xl border border-stone-300 px-4 py-2 text-sm font-medium text-stone-800 hover:border-stone-500", "Download my data (JSON)");
		download.type = "button";
		download.addEventListener("click", () => {
			const blob = new Blob([JSON.stringify({ user: who.user, ...p }, null, 2)], { type: "application/json" });
			const a = h("a") as HTMLAnchorElement;
			a.href = URL.createObjectURL(blob);
			a.download = "market-hub-data.json";
			a.click();
			URL.revokeObjectURL(a.href);
		});
		info.body.append(download);

		const danger = card("Delete your account", "Removes your positions, favourites and profile from our database at once. Signing in again later starts from zero.");
		const del = h("button", "rounded-xl bg-rose-700 px-4 py-2 text-sm font-medium text-white hover:bg-rose-800", "Delete my account");
		del.type = "button";
		const status = h("p", "mt-2 text-sm text-stone-500");
		del.addEventListener("click", async () => {
			if (!confirm("Delete your account and all your saved stocks? This cannot be undone.")) return;
			del.disabled = true;
			try {
				await api("/api/me", { method: "DELETE" });
				(window as any).google?.accounts?.id?.disableAutoSelect?.();
				location.href = link("/");
			} catch (e) {
				del.disabled = false;
				status.textContent = e instanceof Error ? e.message : "Deleting failed.";
			}
		});
		add(danger.body, del, status);
		root.replaceChildren(info.el, danger.el);
	}
	start().catch(() => {});
</script>
