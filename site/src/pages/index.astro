---
// Landing and sign-in. A signed-in visitor goes straight to the dashboard.
import Page from "../components/Page.astro";
import { SITE_NAME, link } from "../lib/site";

const features = [
	["Your portfolio at a glance", "Value, today's move and your gain or loss against your own average cost, position by position, with weights and sectors."],
	["Or just your favourites", "No portfolio? Keep a list of the stocks you follow and see how they move: today, this month, this year, against their 52-week range."],
	["The analysis tools, one click away", "Open any of your stocks in Fundamentals Lab (numbers, valuation, forward multiples, technicals) or the Earnings Radar (what its latest results release says)."],
];
---

<Page title={SITE_NAME} description="Sign in with Google, add your portfolio or your favourite stocks, and monitor them on one dashboard with AI analysis tools a click away.">
	<section class="mx-auto max-w-3xl pt-6 text-center sm:pt-14">
		<h1 class="font-serif text-4xl font-semibold tracking-tight text-stone-900 sm:text-5xl">Your stocks, and the tools to read them</h1>
		<p class="mx-auto mt-4 max-w-2xl text-lg text-stone-600">
			Sign in, add the stocks you own or the ones you follow, and get a dashboard that keeps track of them. From there, open
			any company in the AI analysis tools.
		</p>
		<div class="mt-8 flex flex-col items-center gap-3">
			<div id="signin" class="min-h-[44px]"></div>
			<p id="signin-note" class="text-sm text-stone-500" hidden></p>
			<p class="max-w-md text-xs text-stone-400">
				We keep your Google name, email and picture, and the stocks you add. Nothing else. You can delete it all at any time.{" "}
				<a href={link("/privacy/")} class="underline hover:text-stone-700">Privacy</a>
			</p>
		</div>
	</section>
	<section class="mt-16 grid gap-4 md:grid-cols-3">
		{features.map(([t, d]) => (
			<div class="rounded-2xl border border-stone-200 bg-white p-5">
				<h2 class="font-serif text-lg font-semibold text-stone-900">{t}</h2>
				<p class="mt-2 text-sm leading-relaxed text-stone-600">{d}</p>
			</div>
		))}
	</section>
</Page>

<script>
	import { api, config, signedIn } from "../lib/api";
	import { link } from "../lib/site";

	const box = document.getElementById("signin")!;
	const note = document.getElementById("signin-note")!;
	const say = (text: string) => ((note.textContent = text), (note.hidden = !text));
	// Only paths of this site, so a crafted ?next= cannot send the visitor elsewhere.
	const next = (() => {
		const n = new URLSearchParams(location.search).get("next") ?? "";
		return n.startsWith("/") && !n.startsWith("//") ? n : link("/dashboard/");
	})();

	function loadGoogle(): Promise<void> {
		return new Promise((resolve, reject) => {
			const s = document.createElement("script");
			s.src = "https://accounts.google.com/gsi/client";
			s.async = true;
			s.onload = () => resolve();
			s.onerror = () => reject(new Error("Google sign-in could not load."));
			document.head.append(s);
		});
	}

	async function start() {
		try {
			const who = await signedIn();
			if (who) return location.replace(who.has_data ? next : link("/portfolio/?welcome=1"));
			const cfg = await config();
			if (!cfg.google_client_id) return say("Sign-in is not configured yet.");
			await loadGoogle();
			const g = (window as any).google.accounts.id;
			g.initialize({
				client_id: cfg.google_client_id,
				ux_mode: "popup",
				callback: async (resp: { credential: string }) => {
					say("Signing in…");
					try {
						const r = await api<{ has_data: boolean }>("/api/auth/google", { method: "POST", body: JSON.stringify({ credential: resp.credential }) });
						location.replace(r.has_data ? next : link("/portfolio/?welcome=1"));
					} catch (e) {
						say(e instanceof Error ? e.message : "Sign-in failed.");
					}
				},
			});
			g.renderButton(box, { theme: "filled_black", size: "large", shape: "pill", text: "continue_with", width: 280 });
		} catch (e) {
			say(e instanceof Error ? e.message : "Sign-in is not available right now.");
		}
	}
	start();
</script>
