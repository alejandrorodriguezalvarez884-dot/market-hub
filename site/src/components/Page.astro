---
// Shell shared by every page: header with the navigation and the account menu, body, footer.
import Layout from "../layouts/Layout.astro";
import { AUTHOR_URL, REPO_URL, SITE_NAME, link } from "../lib/site";

interface Props {
	title: string;
	description: string;
	wide?: boolean;
	app?: boolean; // a page for signed-in users: shows the app navigation
}
const { title, description, wide = false, app = false } = Astro.props;
const path = Astro.url.pathname;
const links = [
	{ href: link("/dashboard/"), label: "Dashboard" },
	{ href: link("/portfolio/"), label: "Portfolio" },
	{ href: link("/tools/"), label: "Tools" },
].map((l) => ({ ...l, active: path.startsWith(l.href) }));
const width = wide ? "max-w-6xl" : "max-w-5xl";
---

<Layout title={title === SITE_NAME ? title : `${title} — ${SITE_NAME}`} description={description}>
	<header class="sticky top-0 z-50 border-b border-stone-200/80 bg-stone-50/85 backdrop-blur">
		<nav class={`mx-auto flex ${width} items-center justify-between gap-3 px-4 py-3 sm:px-6`}>
			<a href={link(app ? "/dashboard/" : "/")} class="flex flex-none items-center gap-2 whitespace-nowrap font-serif text-base font-semibold tracking-tight text-stone-900 sm:text-lg">
				<img src={link("/favicon.svg")} alt="" class="h-6 w-6" /><span class={app ? "hidden sm:inline" : ""}>{SITE_NAME}</span>
			</a>
			<div class="flex items-center gap-1">
				{app && (
					<ul class="flex items-center gap-0.5 text-sm sm:gap-1">
						{links.map((l) => (
							<li>
								<a href={l.href} aria-current={l.active ? "page" : undefined}
									class={`whitespace-nowrap rounded-full px-2.5 py-1.5 transition-colors hover:text-stone-900 sm:px-3 ${l.active ? "bg-stone-200/70 font-medium text-stone-900" : "text-stone-600"}`}>{l.label}</a>
							</li>
						))}
					</ul>
				)}
				<div id="account" class="relative ml-1"></div>
			</div>
		</nav>
	</header>
	<main class={`mx-auto ${width} px-4 pb-20 pt-8 sm:px-6 sm:pt-10`}>
		<slot />
		<p class="mt-16 border-t border-stone-200 pt-6 text-xs leading-relaxed text-stone-500">
			Prices and company data from the data provider, possibly delayed. Gains and losses are measured against the average cost you
			entered. Nothing on this site is investment advice or a recommendation to buy or sell any security.
		</p>
	</main>
	<footer class="border-t border-stone-200">
		<div class={`mx-auto ${width} flex flex-wrap justify-center gap-x-3 gap-y-1 px-4 py-8 text-sm text-stone-400 sm:px-6`}>
			<span>Built by <a href={AUTHOR_URL} class="underline hover:text-stone-700">Alejandro Rodríguez Álvarez</a></span>
			<a href={link("/privacy/")} class="underline hover:text-stone-700">Privacy</a>
			<a href={REPO_URL} class="underline hover:text-stone-700">Source on GitHub</a>
		</div>
	</footer>
</Layout>

<script>
	import { api, signedIn } from "../lib/api";
	import { add, h } from "../lib/dom";
	import { link } from "../lib/site";

	// The account menu: the user's picture and a sign-out button, once we know who is signed in.
	const box = document.getElementById("account")!;
	signedIn()
		.then((who) => {
			if (!who) return;
			const button = h("button", "flex h-8 w-8 items-center justify-center overflow-hidden rounded-full border border-stone-300 bg-white text-sm font-semibold text-stone-700");
			button.type = "button";
			button.setAttribute("aria-label", "Account");
			if (who.user.picture) {
				const img = h("img", "h-full w-full object-cover");
				img.src = who.user.picture;
				img.alt = "";
				img.referrerPolicy = "no-referrer";
				img.onerror = () => button.replaceChildren(who.user.name.charAt(0).toUpperCase());
				button.append(img);
			} else button.textContent = who.user.name.charAt(0).toUpperCase();
			const menu = h("div", "absolute right-0 mt-2 w-60 rounded-xl border border-stone-200 bg-white p-2 text-sm shadow-lg");
			menu.hidden = true;
			const out = h("button", "w-full rounded-lg px-3 py-2 text-left text-stone-700 hover:bg-stone-100", "Sign out");
			out.type = "button";
			out.addEventListener("click", async () => {
				await api("/api/auth/logout", { method: "POST" });
				(window as any).google?.accounts?.id?.disableAutoSelect?.();
				location.href = link("/");
			});
			const account = h("a", "block rounded-lg px-3 py-2 text-stone-700 hover:bg-stone-100", "Account and data") as HTMLAnchorElement;
			account.href = link("/account/");
			add(menu, add(h("div", "px-3 py-2"), h("div", "font-medium text-stone-900", who.user.name), h("div", "truncate text-xs text-stone-500", who.user.email)), account, out);
			button.addEventListener("click", () => (menu.hidden = !menu.hidden));
			document.addEventListener("click", (e) => !box.contains(e.target as Node) && (menu.hidden = true));
			add(box, button, menu);
		})
		.catch(() => {});
</script>

<style is:global>
	.font-serif {
		font-family: "Source Serif 4", Georgia, serif;
	}
	.chart-tip {
		position: absolute;
		top: 0;
		transform: translate(-50%, -8px);
		min-width: 140px;
		padding: 8px 10px;
		border-radius: 10px;
		border: 1px solid #e7e5e4;
		background: #fff;
		box-shadow: 0 8px 24px rgba(28, 25, 23, 0.12);
		font-size: 12px;
		pointer-events: none;
		z-index: 10;
	}
	.chart-tip[hidden] {
		display: none;
	}
	.tab-btn {
		border-radius: 9999px;
		padding: 4px 10px;
		font-size: 12px;
		font-weight: 500;
		color: #57534e;
	}
	.tab-btn:hover {
		background: #f5f5f4;
	}
	.tab-btn[aria-selected="true"] {
		background: #1c1917;
		color: #fff;
	}
	.data-table {
		width: 100%;
		font-size: 13px;
		font-variant-numeric: tabular-nums;
	}
	.data-table th,
	.data-table td {
		padding: 8px 10px;
		white-space: nowrap;
		text-align: right;
	}
	.data-table th:first-child,
	.data-table td:first-child {
		text-align: left;
		position: sticky;
		left: 0;
		background: #fff;
	}
	.data-table thead th {
		font-weight: 500;
		color: #78716c;
		border-bottom: 1px solid #e7e5e4;
	}
	.data-table tbody tr + tr td {
		border-top: 1px solid #f5f5f4;
	}
	.field {
		width: 100%;
		border-radius: 10px;
		border: 1px solid #d6d3d1;
		background: #fff;
		padding: 6px 10px;
		font-size: 14px;
		font-variant-numeric: tabular-nums;
	}
	.field:focus {
		outline: none;
		border-color: #78716c;
		box-shadow: 0 0 0 3px rgba(214, 211, 209, 0.6);
	}
</style>
